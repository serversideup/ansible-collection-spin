# {{ ansible_managed }}
{% set ranges = crowdsec_allowlist | select('search', '/') | list %}
{% set addresses = crowdsec_allowlist | reject('search', '/') | list %}
name: serversideup/spin-allowlist
description: "Addresses Spin never blocks"
whitelist:
  reason: "In crowdsec_allowlist"
{% if addresses | length > 0 %}
  ip:
{% for address in addresses %}
    - "{{ address }}"
{% endfor %}
{% endif %}
{% if ranges | length > 0 %}
  cidr:
{% for range in ranges %}
    - "{{ range }}"
{% endfor %}
{% endif %}
